# Copie para .env.local. O Prisma CLI também lê .env; o wrapper de migração carrega .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
WEBHOOK_SECRET=""
# Gateway HTTPS de cada canal. Contrato descrito no README. Nunca use NEXT_PUBLIC para segredos.
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_TOKEN=""
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
WHATSAPP_PROVIDER_URL=""
WHATSAPP_PROVIDER_TOKEN=""
LOAN_DAYS=14
DAILY_FINE_CENTS=100

# Fuso para execução do servidor e worker em produção
TZ="America/Sao_Paulo"

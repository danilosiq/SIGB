# Copie para .env.local. O Prisma CLI também lê .env; o wrapper de migração carrega .env.local.
# Use as variáveis fornecidas pela integração Postgres do projeto Vercel.
# Não é necessário preencher todas: o SIGB reconhece os nomes abaixo.
DATABASE_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
# Conexão direta opcional, usada nas migrações:
DIRECT_URL=""
POSTGRES_URL_NON_POOLING=""
DATABASE_URL_UNPOOLED=""
WEBHOOK_SECRET=""
# Gateway HTTPS de cada canal. Contrato descrito no README. Nunca use NEXT_PUBLIC para segredos.
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_TOKEN=""
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
WHATSAPP_PROVIDER_URL=""
WHATSAPP_PROVIDER_TOKEN=""
LOAN_DAYS=14
DAILY_FINE_CENTS=100

# Fuso para execução do servidor e worker em produção
TZ="America/Sao_Paulo"
